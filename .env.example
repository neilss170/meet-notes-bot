# Scribe configuration. `python -m meetbot setup` copies this to `.env`,
# which is gitignored. Only the two keys below are required.
#
# Everything else Scribe understands - bot mode, the audio bridge, caption
# based speaker names, anonymised analysis - has a working default and is
# documented in docs/configuration.md. Add a line here only to change one.


# --- Required --------------------------------------------------------------

# https://console.deepgram.com/ -> API Keys
DEEPGRAM_API_KEY=

# https://console.anthropic.com/settings/keys
# Only used for the write-up. With ANALYSIS_ENABLED=false you still get
# transcripts and need no key at all.
ANTHROPIC_API_KEY=


# --- Worth setting before your first real meeting --------------------------

# The variety actually being spoken: en-IN, en-GB, en-US. Transcribing Indian
# English as American English garbles it. "hi" and "multi" work too.
DEEPGRAM_LANGUAGE=en-IN

# Comma-separated names and jargon to bias transcription towards. ASR fails
# hardest on exactly the words a summary needs most - people's names, product
# names - because they are rare in the language model. Put your team here;
# it is the cheapest accuracy win there is.
DEEPGRAM_KEYTERMS=


# --- Behaviour -------------------------------------------------------------

# false = transcripts only, no LLM call and no key needed.
ANALYSIS_ENABLED=true

# "anthropic" or "openai". The openai provider also reaches any
# OpenAI-compatible endpoint via LLM_BASE_URL - see docs/configuration.md.
LLM_PROVIDER=anthropic

# false = wait for someone to press "Enhance notes" instead of writing the
# notes up automatically when a recording ends.
AUTO_NOTES=true

# true = when any app starts using the microphone, offer to record it.
# Windows only.
CALL_ALERTS=true

# true = listen for "Scribe, start recording" and three other phrases using
# the speech recogniser built into Windows. Offline, and it can only hear
# those phrases - but Scribe then holds the microphone the whole time it
# runs, so Windows shows its microphone indicator throughout. Off by default
# because that is a thing to agree to rather than discover.
VOICE_COMMANDS=false

# One directory per meeting.
OUTPUT_DIR=recordings

LOG_LEVEL=INFO
