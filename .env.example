# ---------------------------------------------------------------------------
# meetbot configuration. Copy to `.env` and fill in. `.env` is gitignored.
# ---------------------------------------------------------------------------

# --- Required: live transcription -----------------------------------------
# https://console.deepgram.com/ -> API Keys
DEEPGRAM_API_KEY=
DEEPGRAM_MODEL=nova-3
DEEPGRAM_LANGUAGE=en-IN
# Names and jargon to bias transcription towards (nova-3 only).
# Add your team's names here - it is the cheapest accuracy win there is.
DEEPGRAM_KEYTERMS=Scribe,Deepgram,Groq,transcript,transcription,captions,Google Meet,Playwright,speaker diarization,action items,Neil Sharma

# Silence (ms) that ends an utterance. This is an ACCURACY control, not only
# a latency one: at 300 ms - shorter than an ordinary pause for breath -
# sentences were being cut in half, which reads badly and denies the model
# the context it uses to choose words and place punctuation. Lower it for
# snappier live captions, raise it for cleaner text.
DEEPGRAM_ENDPOINTING_MS=800
# Ceiling (ms) on how long one utterance may run without a pause, so a long
# unbroken stretch of speech is still split into readable turns.
DEEPGRAM_UTTERANCE_END_MS=1000

# --- Required for the post-meeting analysis (unless you pass --no-analysis) -
# Which provider generates the summary: "anthropic" or "openai".
LLM_PROVIDER=anthropic
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# Leave blank to use the provider default (claude-opus-5 / gpt-4o).
LLM_MODEL=
ANALYSIS_ENABLED=true

# Point the "openai" provider at any OpenAI-compatible endpoint. Use this to
# run the analysis on a free tier while prototyping. Groq's free developer
# tier does not train on your data and needs no credit card:
#   LLM_PROVIDER=openai
#   LLM_BASE_URL=https://api.groq.com/openai/v1
#   OPENAI_API_KEY=<your Groq key>
#   LLM_MODEL=openai/gpt-oss-120b
# LLM_MODEL is REQUIRED here - the blank default is gpt-4o, which only
# exists on OpenAI. Groq retires model ids without notice, so if you get a
# 404 list the live ones: GET {LLM_BASE_URL}/models with your key.
# Blank LLM_BASE_URL uses api.openai.com as before.
LLM_BASE_URL=

# --- Meeting ---------------------------------------------------------------
# Optional default; --url on the command line overrides it.
MEET_URL=
# MUST make it obvious to participants that this account records the meeting.
# A disclosure suffix is appended automatically if it does not.
BOT_DISPLAY_NAME=Scribe (Recording)
OUTPUT_DIR=recordings

# --- Join / lifecycle behaviour --------------------------------------------
# Set to false to watch the browser - the way to debug broken Meet selectors.
HEADLESS=true
# Seconds to wait in the lobby for a host to admit the bot.
ADMISSION_TIMEOUT_S=300
# Hard cap on a single meeting, in seconds (default 4 hours).
MAX_MEETING_DURATION_S=14400
# Leave after this many seconds alone in the call.
ALONE_TIMEOUT_S=120
# Playwright browser channel, e.g. "chrome". Blank uses bundled Chromium.
BROWSER_CHANNEL=

# --- Audio capture ---------------------------------------------------------
BRIDGE_HOST=127.0.0.1
BRIDGE_PORT=8765
SAMPLE_RATE=16000
# true = one Deepgram stream per participant (better speaker labels, costs one
# connection per participant). false = one mixed stream with diarization.
PER_PARTICIPANT_AUDIO=false
# true = share a live-caption canvas as a screen-share, updated as speech is
# transcribed - visible to every participant, without turning the bot's own
# camera on. Changes what OTHER participants see, so
# it is off by default; the one Meet-DOM step it depends on ("Present now")
# is unverified against a live call - see PRESENT_NOW_BUTTON in selectors.py.
LIVE_CAPTIONS_OVERLAY=false
# true = turn Meet's own live captions on (for THIS browser only) and use the
# speaker name Meet attaches to each caption entry, instead of Deepgram's
# generic Speaker 0 / Speaker 1. This is the only way to get real names -
# nothing links an audio track to a participant. Only the name and the timing
# are used; the caption text itself is discarded. Enabling captions is a
# per-viewer setting and does not turn on captions, transcription or recording
# for anybody else in the call. Falls back to generic labels if unavailable.
SPEAKER_NAMES_FROM_CAPTIONS=true
# true = replace real names with "Speaker A" / "Speaker B" in the transcript
# text sent to the LLM. The local transcript keeps the real names; only the
# third-party request is anonymised. Use for meetings where personal names
# should not leave the machine.
ANONYMISE_ANALYSIS=false
# Persistent Chromium profile holding a signed-in Google session, created by
# `python -m meetbot login`. Without it the bot joins anonymously, and Meet
# increasingly REFUSES anonymous guests outright - the pre-join screen is
# replaced by "You can't join this video call" and the host is never even
# asked. No selector can work around that; signing in is the fix. It also
# makes the bot appear as a named participant.
# This directory holds live Google session cookies: treat it like a password,
# keep it out of version control, and do not put it on a shared machine.
CHROME_PROFILE_DIR=

# --- Call alerts -----------------------------------------------------------
# true = when any app starts using the microphone - a Meet tab, WhatsApp,
# Zoom, Teams, anything - offer to record it, with a card in the page and a
# Windows notification. Reads the per-app microphone state Windows keeps for
# its own privacy indicator; no audio is opened. Windows only.
CALL_ALERTS=true

# --- Notes -----------------------------------------------------------------
# true = write the notes as soon as a recording ends, instead of waiting for
# somebody to press "Enhance notes". Same model, same template, same result -
# it just happens without being asked, which is the point of a notetaker.
# Costs one LLM call per finished meeting, so set it false on a metered key if
# you would rather choose which meetings are worth writing up.
AUTO_NOTES=true

# --- Logging ---------------------------------------------------------------
LOG_LEVEL=INFO
