# Secrets - never commit
.env
.env.*
!.env.example

# Run artifacts
recordings/
*.jsonl
*.log

# Python
__pycache__/
*.py[cod]
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
*.egg-info/
build/
dist/

# Editors / OS
.vscode/
.idea/
.DS_Store
Thumbs.db

# Signed-in Chromium profile (python -m meetbot login). Holds live Google
# session cookies - committing it would hand over the bot's account.
chrome-profile/
.meetbot/
*.profile/

# Generated by `meetbot shortcut` for the Desktop icon. The name
# carries a fingerprint of the drawing, so it changes with the mark.
scribe*.ico

# Where a windowless server's output goes, plus the rotated copies.
scribe-server.log*
